# PrivacyLens Environment Variables
# Copy this file to .env and fill in your real values
# NEVER commit your real .env file to git

# Required — get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — get from https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional — Google Cloud Console
GOOGLE_TRANSLATE_API_KEY=your_translate_api_key_here

# Model settings (defaults shown)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_TOKENS=8192

# Cache directory
CACHE_DIR=.cache
